{
  "name": "lifehq-ecosystem",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lifehq/app",
    "dev:vault": "npm run dev -w @lifehq/vault",
    "build": "npm run build -w @lifehq/app && npm run build -w @lifehq/vault",
    "typecheck": "tsc --noEmit -p apps/lifehq && tsc --noEmit -p apps/ciphervault",
    "lint": "eslint apps packages tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
