# Copy to apps/lifehq/.env.local. Publishable key is safe for the browser; never use a service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional separate vault origin. Production requires a verified HTTPS address; localhost is for local development only.
NEXT_PUBLIC_VAULT_URL=http://localhost:3001
